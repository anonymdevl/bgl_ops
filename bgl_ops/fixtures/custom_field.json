  "fieldtype": "Int",
  "insert_after": "custom_thp_cb",
  "default": "22",
  "description": "Days in a full working month. Betonsa uses 22."
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_thp_split_sb",
